%% Figure 9 / Chapter Figure 4.6 - Overall Promotion Process Activity Diagram
flowchart LR
    Start([Start]):::terminal

    subgraph L["Lecturer"]
        direction TB
        L1["Create application"]:::process
        L2["Upload required evidence"]:::process
        L3{"Evidence complete?"}:::decision
    end

    subgraph H["HOD / Dean Review"]
        direction TB
        H1["Receive scoped review notification"]:::process
        H2["Assess academic completeness"]:::process
        H3{"Forward to HR?"}:::decision
    end

    subgraph R["HR Verification"]
        direction TB
        R1["Verify documents"]:::process
        R2{"Required categories verified?"}:::decision
        R3["Calculate criteria score"]:::process
        R4{"Meets configured threshold?"}:::decision
    end

    subgraph C["Committee Review"]
        direction TB
        C1["Review eligible dossier"]:::process
        C2["Record recommendation"]:::process
        C3{"Outcome?"}:::decision
    end

    subgraph F["Final Recording"]
        direction TB
        F1["HR records authority approval"]:::process
        F2["Complete workflow and notify applicant"]:::process
    end

    End([End]):::terminal
    Correction["Return to lecturer for correction"]:::exception
    Further["Further review required"]:::exception
    NotRec["Not recommended; close workflow"]:::exception

    Start --> L1 --> L2 --> L3
    L3 -- No --> L2
    L3 -- Yes --> H1 --> H2 --> H3
    H3 -- No --> Correction -. resubmit .-> L2
    H3 -- Yes --> R1 --> R2
    R2 -- No --> Correction
    R2 -- Yes --> R3 --> R4
    R4 -- No --> Further -. recheck .-> R1
    R4 -- Yes --> C1 --> C2 --> C3
    C3 -- Further review --> Further
    C3 -- Not recommended --> NotRec --> F2
    C3 -- Recommended --> F1 --> F2 --> End

    classDef terminal fill:#111827,stroke:#111827,color:#FFFFFF,stroke-width:1.5px;
    classDef process fill:#EFF6FF,stroke:#1D4ED8,stroke-width:1.4px,color:#0F172A;
    classDef decision fill:#FFF7ED,stroke:#C2410C,stroke-width:1.6px,color:#0F172A;
    classDef exception fill:#FEF2F2,stroke:#B91C1C,stroke-width:1.5px,color:#0F172A;
