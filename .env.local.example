# Prisma Database Configuration
# PostgreSQL / Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
AUTH_SECRET=replace-with-a-long-random-secret

# Email verification
EMAIL_PROVIDER=development
APP_URL=http://localhost:3000
# To test real email locally, switch EMAIL_PROVIDER to resend and set these values:
# RESEND_API_KEY=re_replace_with_your_resend_api_key
# EMAIL_FROM="GCTU Promotion System <gctu-promotion@techdalt.com>"

# Legacy admin bootstrap credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
