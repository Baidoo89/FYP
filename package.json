{
  "name": "lecturer-performance-system",
  "version": "1.0.0",
  "description": "GCTU Promotion System - Promotion Analysis and Decision Support Platform",
  "scripts": {
    "dev": "next dev",
    "dev:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-safe.ps1",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path .next) { Remove-Item .next -Recurse -Force -ErrorAction SilentlyContinue }\"",
    "prebuild": "node ./scripts/prisma-generate.js",
    "build": "next build",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "deploy:prod": "prisma generate --schema prisma/schema.postgres.prisma && prisma migrate deploy --schema prisma/schema.postgres.prisma && next build",
    "cutover:prod": "node ./scripts/cutover-prod.js",
    "cutover:prod:check": "node ./scripts/cutover-prod.js --check-only",
    "start": "next start",
    "lint": "next lint",
    "db:migrate:dev": "dotenv -e .env.local -- prisma migrate dev --schema prisma/schema.prisma",
    "db:reset:dev": "dotenv -e .env.local -- prisma migrate reset --schema prisma/schema.prisma --force",
    "db:seed": "dotenv -e .env.local -- node prisma/seed.js",
    "db:health": "dotenv -e .env.local -- node scripts/db-health-check.js",
    "db:clean-test-data": "dotenv -e .env.local -- node scripts/cleanup-test-data.js",
    "db:fresh-start": "dotenv -e .env.local -- node scripts/cleanup-test-data.js --fresh-start",
    "db:wipe:fresh": "dotenv -e .env.local -- node scripts/wipe-fresh-install.js --confirm",
    "reset:seed-auth": "dotenv -e .env.local -- node scripts/reset-seed-auth.js",
    "defence:prepare": "dotenv -e .env.local -- node scripts/prepare-defence-demo.js",
    "defence:check": "dotenv -e .env.local -- node scripts/prepare-defence-demo.js --check",
    "defence:live-check": "node scripts/verify-defence-server.js",
    "defence:team-brief": "node scripts/create-defence-team-brief.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "mysql2": "^3.11.3",
    "next": "^15.1.0",
    "openai": "^6.35.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@prisma/internals": "^7.8.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "docx": "^9.7.1",
    "dotenv-cli": "^11.0.0",
    "pdfkit": "^0.19.1",
    "postcss": "^8.4.0",
    "pptxgenjs": "^4.0.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
