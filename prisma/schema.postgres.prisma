  sourceClause       String?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  requirements      PromotionRouteRequirement[]
  areaRequirements  PromotionRouteAreaRequirement[]
  promotionRequests PromotionRequest[]
  academicPackets   AcademicAssessmentPacket[]

  @@unique([promotionTrackId, code])
  @@index([currentRankId, targetRankId, status])
  @@index([finalAuthority])
  @@map("promotion_routes")
}

model AssessmentAreaDefinition {
  id               Int            @id @default(autoincrement())
  promotionTrackId Int
