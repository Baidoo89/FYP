model PromotionFormSubmission {
  id                 Int                          @id @default(autoincrement())
  promotionRequestId Int
  promotionRequest   PromotionRequest             @relation(fields: [promotionRequestId], references: [id], onDelete: Cascade)
  templateId         Int
  template           OfficialFormTemplate         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  stageRecordId      Int?
  stageRecord        PromotionStageRecord?        @relation(fields: [stageRecordId], references: [id], onDelete: SetNull)
  completedById      Int?
  completedBy        User?                        @relation("OfficialFormCompleters", fields: [completedById], references: [id], onDelete: SetNull)
  externalAssessorId Int?
  externalAssessor   ExternalAssessor?            @relation(fields: [externalAssessorId], references: [id], onDelete: SetNull)
  status             OfficialFormSubmissionStatus @default(DRAFT)
  version            Int                          @default(1)
  templateSnapshot   Json
  responses          Json
  completionPercent  Int                          @default(0)
  validationErrors   Json?
  isConfidential     Boolean                      @default(false)
  declared           Boolean                      @default(false)
  declarationText    String?
  signedName         String?
  signedAt           DateTime?
  signedIpAddress    String?
  signedUserAgent    String?
  submittedAt        DateTime?
  frozenAt           DateTime?
  returnedReason     String?
  supersedesId       Int?
  supersedes         PromotionFormSubmission?     @relation("FormSubmissionSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy       PromotionFormSubmission[]    @relation("FormSubmissionSupersession")
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([promotionRequestId, templateId, completedById, version], map: "promotion_form_submission_version_key")
  @@unique([promotionRequestId, templateId, externalAssessorId, version], map: "promotion_form_external_assessor_version_key")
  @@index([promotionRequestId, status])
  @@index([templateId, status])
  @@index([stageRecordId])
  @@index([completedById])
  @@index([externalAssessorId])
  @@index([supersedesId])
  @@map("promotion_form_submissions")
}
