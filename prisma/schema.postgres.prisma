  @@index([type, staffCategory, status])
  @@map("promotion_tracks")
}

model PromotionRoute {
  id                 Int                 @id @default(autoincrement())
  promotionTrackId   Int
  promotionTrack     PromotionTrack      @relation(fields: [promotionTrackId], references: [id], onDelete: Restrict)
  code               String
  name               String
  currentRankId      Int?
  currentRank        RankDefinition?     @relation("CurrentPromotionRank", fields: [currentRankId], references: [id], onDelete: Restrict)
  targetRankId       Int
  targetRank         RankDefinition      @relation("TargetPromotionRank", fields: [targetRankId], references: [id], onDelete: Restrict)
  minimumYearsInRank Int?
  normalProgression  Boolean             @default(true)
  finalAuthority     DecisionAuthority?
  evidenceState      PolicyEvidenceState @default(CONFIRMATION_REQUIRED)
