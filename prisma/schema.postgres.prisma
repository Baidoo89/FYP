generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  LECTURER
  HOD_DEAN
  HR_ADMIN
  COMMITTEE_REVIEWER
  SYSTEM_ADMIN
}

enum AcademicRank {
  ASSISTANT_LECTURER
  LECTURER
  SENIOR_LECTURER
  ASSOCIATE_PROFESSOR
  PROFESSOR
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_DEPARTMENT_REVIEW
  UNDER_REVIEW
  RETURNED_FOR_CORRECTION
  UNDER_HR_VERIFICATION
  UNDER_COMMITTEE_REVIEW
  ELIGIBLE
  NOT_ELIGIBLE
  REQUIRES_FURTHER_REVIEW
  RECOMMENDED
  NOT_RECOMMENDED
  APPROVED_BY_AUTHORITY
  APPROVED
  REJECTED
  COMPLETED
}

enum DocumentCategory {
  TEACHING
  RESEARCH
  SERVICE
  QUALIFICATIONS
  PUBLICATIONS
  PROFESSIONAL_DEVELOPMENT
  OTHER_SUPPORTING_EVIDENCE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  REQUIRES_CORRECTION
}

enum EligibilityStatus {
  NOT_CALCULATED
  ELIGIBLE
  NOT_ELIGIBLE
  INCOMPLETE_APPLICATION
  REQUIRES_FURTHER_REVIEW
  NEEDS_REVIEW
}

enum PerformanceCategory {
  EXCELLENT
  VERY_GOOD
  GOOD
  SATISFACTORY
  UNSATISFACTORY
}

enum ReviewRecommendation {
  RECOMMENDED
  NOT_RECOMMENDED
  REQUIRES_FURTHER_REVIEW
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum CommunicationDeliveryStatus {
  LOGGED
  SENT
  FAILED
}

enum CommunicationPurpose {
  ACCOUNT_SETUP
  STAFF_ACTIVATION
  PROMOTION_MILESTONE
  EXTERNAL_ASSESSOR_INVITATION
  QUARTERLY_STATUS_UPDATE
  DECISION_NOTICE
  GENERAL
}

enum RecordAccessClassification {
  OPEN
  CONFIDENTIAL
  CONFIDENTIAL_SENSITIVE
  SECRET
}

enum RecordLifecycleStatus {
  ACTIVE
  CLOSED
  UNDER_HOLD
  ARCHIVED
  DISPOSITION_AUTHORIZED
  DISPOSED
}

enum StaffCategory {
  ACADEMIC_SENIOR_MEMBER
  ADMINISTRATIVE_SENIOR_MEMBER
  PROFESSIONAL_SENIOR_MEMBER
  SENIOR_STAFF
  JUNIOR_STAFF
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RETIRED
  RESIGNED
  TERMINATED
  DECEASED
}

enum RecordVerificationState {
  PENDING
  VERIFIED
  DISPUTED
  SUPERSEDED
}

enum OrganizationUnitType {
  UNIVERSITY
  FACULTY
  SCHOOL
  INSTITUTE
  CENTRE
  DIRECTORATE
  DEPARTMENT
  UNIT
  SECTION
  CAMPUS
  LIBRARY
  OTHER
}

enum PolicyAuthority {
  ACT
  BASIC_LAWS
  COUNCIL_POLICY
  CONDITIONS_OF_SERVICE
  OFFICIAL_FORM
  MANUAL_HANDBOOK
  IMPLEMENTATION_DIRECTIVE
  DESIGN_STANDARD
}

enum PolicyVersionStatus {
  DRAFT
  PROVISIONAL
  ACTIVE
  SUPERSEDED
  RETIRED
  BLOCKED
}

enum PolicyEvidenceState {
  VERIFIED
  VERIFIED_CONFLICT
  CONFIRMATION_REQUIRED
  DESIGN_CONTROL
  DISABLED_PENDING_POLICY
}

enum StaffAccessRole {
  APPLICANT
  HOD
  DEAN
  HEAD_OF_UNIT
  HRODD_OFFICER
  REGISTRAR_OFFICER
  FAPC_MEMBER
  RAPC_MEMBER
  UAPC_MEMBER
  COUNCIL_MEMBER
  SENIOR_STAFF_COMMITTEE_MEMBER
  JUNIOR_STAFF_COMMITTEE_MEMBER
  APPEALS_BOARD_MEMBER
  RECORDS_OFFICER
  LIBRARY_VERIFIER
  QA_VERIFIER
}

enum PromotionTrackType {
  SCHEDULE_J
  SCHEDULE_K
  SENIOR_STAFF_UNIFIED_SCHEME
  JUNIOR_STAFF_UNIFIED_SCHEME
}

enum DecisionAuthority {
  HRODD
  FAPC
  RAPC
  SENIOR_STAFF_APPOINTMENTS_AND_PROMOTIONS_COMMITTEE
  JUNIOR_STAFF_APPOINTMENTS_AND_PROMOTIONS_COMMITTEE
  UAPC
  ACADEMIC_BOARD
  COUNCIL
  APPEALS_BOARD
}

enum PolicyRequirementType {
  MINIMUM_YEARS_IN_RANK
  OUTPUTS_SUBMITTED_MINIMUM
  OUTPUTS_SUBMITTED_MAXIMUM
  REFEREED_OUTPUTS_MINIMUM
  BEST_OUTPUTS_COUNT
  MINIMUM_AREA_CLASSIFICATION
  CLASSIFICATION_COMBINATION
  EXTERNAL_ASSESSOR_COUNT
  ASSESSOR_OUTSIDE_GHANA_MINIMUM
  RETIREMENT_LEAD_MONTHS
  EFFECTIVE_DATE_WINDOW
  SPECIAL_ROUTE_CONDITION
  OTHER
}

enum PolicyConflictStatus {
  OPEN
  PROVISIONALLY_RESOLVED
  RESOLVED
  ACCEPTED_RISK
}

enum PromotionStage {
  DEPARTMENT
  FACULTY
  RAPC
  EXTERNAL_ASSESSMENT
  UAPC
  COUNCIL
  ACADEMIC_BOARD
  FINAL_NOTIFICATION
  APPEAL
}

enum PromotionStageStatus {
  PENDING
  IN_PROGRESS
  RETURNED
  COMPLETED
  WAIVED
  BLOCKED
}

enum ExternalAssessorStatus {
  NOMINATED
  CONFLICTED
  INVITED
  ACCEPTED
  DECLINED
  REPORT_REQUESTED
  REPORT_RECEIVED
  REPLACED
  WITHDRAWN
}

enum AssessmentType {
  APPLICANT_SELF
  HEAD_OF_UNIT
  HOD_TEACHING
  DEAN
  FAPC
  RAPC
  EXTERNAL_ASSESSOR
  UAPC
  COUNCIL
}

enum OfficialFormAudience {
  APPLICANT
  SUPERVISOR
  DEPARTMENT
  FACULTY
  RAPC
  EXTERNAL_ASSESSOR
  UAPC
  COUNCIL
  HRODD
  REGISTRAR
  LIBRARY
}

enum OfficialFormSubmissionStatus {
  DRAFT
  READY
  SUBMITTED
  FROZEN
  RETURNED
  SUPERSEDED
}

enum AppealStatus {
  FILED
  UNDER_REVIEW
  HEARING_SCHEDULED
  DECIDED
  WITHDRAWN
  CLOSED
}

enum DossierStatus {
  DRAFT
  READY_FOR_SUBMISSION
  FROZEN
  SUPERSEDED
}

enum AcademicPacketStatus {
  DRAFT
  FROZEN
  SUPERSEDED
}

enum ScholarlyOutputType {
  REFEREED_JOURNAL_ARTICLE
  PEER_REVIEWED_HIGHER_EDUCATION_BOOK
  PEER_REVIEWED_EXHIBITION
  INDEXED_CONFERENCE_PROCEEDING
  NON_INDEXED_CONFERENCE_PROCEEDING
  DEPLOYED_TECHNOLOGY_PRODUCT_DESIGN
  PATENTED_INVENTION
  PEER_REVIEWED_BOOK_CHAPTER
  NON_PEER_REVIEWED_BOOK_CHAPTER
}

model AdminAccount {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password_hash String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  @@map("admin_accounts")
}

model Faculty {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  departments Department[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("faculties")
}

model Department {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  facultyId   Int?
  faculty     Faculty?   @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  users       User[]
  lecturers   Lecturer[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([facultyId])
  @@map("departments")
}

model Lecturer {
  id            Int         @id @default(autoincrement())
  name          String
  email         String      @unique
  department    String
  departmentId  Int?
  departmentRef Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  rank          String
  hire_date     DateTime
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  @@map("lecturers")
}

model User {
  id              Int           @id @default(autoincrement())
  name            String
  email           String        @unique
  password        String?
  passwordHash    String?
  role            Role          @default(LECTURER)
  staffId         String?       @unique
  department      String?
  departmentId    Int?
  departmentRef   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  facultyId       Int?
  faculty         Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  currentRank     AcademicRank?
  phone           String?
  emailVerified   Boolean       @default(false)
  emailVerifiedAt DateTime?
  isActive        Boolean       @default(true)
  onboarded       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lecturerRequests          PromotionRequest[]            @relation("LecturerPromotionRequests")
  applicantRequests         PromotionRequest[]            @relation("ApplicantPromotionRequests")
  requestedPromotions       PromotionRequest[]            @relation("RequestedPromotions")
  completedReviews          PromotionRequest[]            @relation("CompletedPromotionReviews")
  verifiedDocuments         Document[]                    @relation("VerifiedDocuments")
  uploadedDocuments         Document[]                    @relation("UploadedDocuments")
  verifications             Verification[]                @relation("VerifierVerifications")
  reviewComments            ReviewComment[]               @relation("ReviewerComments")
  auditLogs                 AuditLog[]                    @relation("AuditActor")
  statusChanges             StatusHistory[]               @relation("StatusChangedBy")
  notifications             Notification[]
  emailVerificationTokens   EmailVerificationToken[]
  scores                    Score[]                       @relation("ScoreCreatedBy")
  criteriaCreated           PromotionCriteria[]           @relation("CriteriaCreatedBy")
  criteriaUpdated           PromotionCriteria[]           @relation("CriteriaUpdatedBy")
  staffMember               StaffMember?
  departmentVerifiedOutputs ScholarlyOutput[]             @relation("DepartmentOutputVerifier")
  libraryVerifiedOutputs    ScholarlyOutput[]             @relation("LibraryOutputVerifier")
  frozenAcademicPackets     AcademicAssessmentPacket[]    @relation("AcademicPacketFreezer")
  promotionStageAssignments PromotionStageRecord[]        @relation("PromotionStageAssignments")
  promotionAssessments      PromotionAssessment[]         @relation("PromotionAssessments")
  assessorNominations       ExternalAssessor[]            @relation("AssessorNominators")
  assessorAppointments      ExternalAssessor[]            @relation("AssessorAppointers")
  committeeChairs           CommitteeMeeting[]            @relation("CommitteeChairs")
  committeeSecretaries      CommitteeMeeting[]            @relation("CommitteeSecretaries")
  committeeParticipations   CommitteeMeetingParticipant[] @relation("CommitteeParticipants")
  promotionAppealFilers     AppealCase[]                  @relation("PromotionAppealFilers")
  promotionAppealDeciders   AppealCase[]                  @relation("PromotionAppealDeciders")
  officialFormSubmissions   PromotionFormSubmission[]     @relation("OfficialFormCompleters")
  communicationDeliveries   CommunicationDelivery[]       @relation("CommunicationRecipients")

  @@index([role])
  @@index([departmentId])
  @@index([facultyId])
  @@map("users")
}

model PromotionRequest {
  id                       Int                          @id @default(autoincrement())
  applicantId              Int?
  lecturerId               Int
  applicant                User?                        @relation("ApplicantPromotionRequests", fields: [applicantId], references: [id], onDelete: SetNull)
  lecturer                 User                         @relation("LecturerPromotionRequests", fields: [lecturerId], references: [id], onDelete: Cascade)
  requestedById            Int?
  requestedBy              User?                        @relation("RequestedPromotions", fields: [requestedById], references: [id], onDelete: SetNull)
  promotionRouteId         Int?
  promotionRoute           PromotionRoute?              @relation(fields: [promotionRouteId], references: [id], onDelete: Restrict)
  staffRankHistoryId       Int?
  staffRankHistory         StaffRankHistory?            @relation(fields: [staffRankHistoryId], references: [id], onDelete: Restrict)
  staffAssignmentId        Int?
  staffAssignment          StaffOrganizationAssignment? @relation(fields: [staffAssignmentId], references: [id], onDelete: Restrict)
  policySnapshot           Json?
  currentRank              String
  targetRank               String
  yearsInCurrentRank       Int                          @default(0)
  status                   RequestStatus                @default(DRAFT)
  eligibilityStatus        EligibilityStatus            @default(NOT_CALCULATED)
  eligibilityReason        String?
  totalScore               Float?
  adminComment             String?
  submittedAt              DateTime?
  verifiedAt               DateTime?
  reviewedAt               DateTime?
  reviewedById             Int?
  reviewedBy               User?                        @relation("CompletedPromotionReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  completedAt              DateTime?
  caseDueAt                DateTime?
  nextApplicantUpdateDueAt DateTime?
  effectiveDate            DateTime?
  decisionCommunicatedAt   DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  documents               Document[]
  scores                  Score[]
  reviewComments          ReviewComment[]
  auditLogs               AuditLog[]
  statusHistory           StatusHistory[]
  notifications           Notification[]
  academicDossier         AcademicDossier?
  workflowStages          PromotionStageRecord[]
  assessments             PromotionAssessment[]
  externalAssessors       ExternalAssessor[]
  committeeMeetings       CommitteeMeeting[]
  appealCases             AppealCase[]
  formSubmissions         PromotionFormSubmission[]
  communicationDeliveries CommunicationDelivery[]
  recordControl           PromotionRecordControl?

  @@index([promotionRouteId])
  @@index([staffRankHistoryId])
  @@index([staffAssignmentId])
  @@index([applicantId])
  @@index([lecturerId])
  @@index([status])
  @@index([eligibilityStatus])
  @@index([caseDueAt])
  @@map("promotion_requests")
}

model Document {
  id                  Int                @id @default(autoincrement())
  promotionRequestId  Int?
  requestId           Int
  request             PromotionRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedById        Int?
  uploadedBy          User?              @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)
  category            DocumentCategory
  title               String
  description         String?
  fileUrl             String
  fileName            String
  fileType            String             @default("")
  mimeType            String?
  fileSize            Int
  status              VerificationStatus @default(PENDING)
  verificationStatus  VerificationStatus @default(PENDING)
  verifiedById        Int?
  verifiedBy          User?              @relation("VerifiedDocuments", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationComment String?
  verifiedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  uploadedAt          DateTime           @default(now())

  verifications           Verification[]
  fileBlob                DocumentFileBlob?
  externalAssessorReports ExternalAssessor[] @relation("ExternalAssessorReports")
  committeeMinutes        CommitteeMeeting[] @relation("CommitteeMinutes")

  @@unique([requestId, category])
  @@index([promotionRequestId])
  @@index([requestId])
  @@index([uploadedById])
  @@index([verifiedById])
  @@index([category])
  @@index([status])
  @@map("documents")
}

model DocumentFileBlob {
  documentId Int      @id
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([fileName])
  @@map("document_file_blobs")
}

model Verification {
  id         Int                @id @default(autoincrement())
  documentId Int
  document   Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  verifierId Int
  verifier   User               @relation("VerifierVerifications", fields: [verifierId], references: [id], onDelete: Restrict)
  decision   VerificationStatus
  comment    String?
  createdAt  DateTime           @default(now())

  @@index([documentId])
  @@index([verifierId])
  @@map("verifications")
}

model PromotionCriteria {
  id                                  Int                 @id @default(autoincrement())
  currentRank                         AcademicRank
  targetRank                          AcademicRank
  minimumYearsInCurrentRank           Int
  requiredDocumentCategories          DocumentCategory[]
  requiredTeachingEvidence            Int                 @default(1)
  requiredResearchPublicationEvidence Int                 @default(1)
  requiredServiceEvidence             Int                 @default(1)
  minimumPerformanceCategory          PerformanceCategory
  scoringEnabled                      Boolean             @default(true)
  minimumTotalScore                   Float?
  publicationRequirement              String?
  professionalDevelopmentRequirement  String?
  optionalReviewerNotes               String?
  isActive                            Boolean             @default(true)
  createdById                         Int?
  createdBy                           User?               @relation("CriteriaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById                         Int?
  updatedBy                           User?               @relation("CriteriaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                           DateTime            @default(now())
  updatedAt                           DateTime            @updatedAt

  @@unique([currentRank, targetRank])
  @@index([isActive])
  @@map("promotion_criteria")
}

model Score {
  id                  Int                  @id @default(autoincrement())
  promotionRequestId  Int
  promotionRequest    PromotionRequest     @relation(fields: [promotionRequestId], references: [id], onDelete: Cascade)
  category            DocumentCategory
  score               Float
  weight              Float
  weightedScore       Float
  performanceCategory PerformanceCategory?
  createdById         Int?
  createdBy           User?                @relation("ScoreCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([promotionRequestId, category])
  @@index([promotionRequestId])
  @@map("scores")
}

model ReviewComment {
  id                 Int                   @id @default(autoincrement())
  promotionRequestId Int
  promotionRequest   PromotionRequest      @relation(fields: [promotionRequestId], references: [id], onDelete: Cascade)
  reviewerId         Int
  reviewer           User                  @relation("ReviewerComments", fields: [reviewerId], references: [id], onDelete: Restrict)
  comment            String
  recommendation     ReviewRecommendation?
  createdAt          DateTime              @default(now())

  @@index([promotionRequestId])
  @@index([reviewerId])
  @@map("review_comments")
}

model AuditLog {
  id          Int               @id @default(autoincrement())
  requestId   Int?
  request     PromotionRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId     Int?
  actor       User?             @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  description String?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([requestId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id                 Int               @id @default(autoincrement())
  userId             Int
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotionRequestId Int?
  promotionRequest   PromotionRequest? @relation(fields: [promotionRequestId], references: [id], onDelete: Cascade)
  title              String
  message            String
  type               NotificationType  @default(INFO)
  isRead             Boolean           @default(false)
  createdAt          DateTime          @default(now())

  @@index([userId, isRead])
  @@index([promotionRequestId])
  @@map("notifications")
}

model CommunicationDelivery {
  id                 Int                         @id @default(autoincrement())
  promotionRequestId Int?
  promotionRequest   PromotionRequest?           @relation(fields: [promotionRequestId], references: [id], onDelete: Cascade)
  recipientUserId    Int?
  recipientUser      User?                       @relation("CommunicationRecipients", fields: [recipientUserId], references: [id], onDelete: SetNull)
  externalAssessorId Int?
  externalAssessor   ExternalAssessor?           @relation(fields: [externalAssessorId], references: [id], onDelete: SetNull)
  purpose            CommunicationPurpose
  recipientAddress   String
  subject            String
  provider           String
  providerMessageId  String?
  status             CommunicationDeliveryStatus
  errorMessage       String?
  metadata           Json?
  attemptedAt        DateTime                    @default(now())
  sentAt             DateTime?

  @@index([promotionRequestId, attemptedAt])
  @@index([recipientUserId, attemptedAt])
  @@index([externalAssessorId, attemptedAt])
  @@index([status, attemptedAt])
  @@map("communication_deliveries")
}

model PromotionRecordControl {
  id                              Int                        @id @default(autoincrement())
  promotionRequestId              Int                        @unique
  promotionRequest                PromotionRequest           @relation(fields: [promotionRequestId], references: [id], onDelete: Cascade)
  accessClassification            RecordAccessClassification @default(CONFIDENTIAL_SENSITIVE)
  retentionClass                  String                     @default("EMPLOYMENT_END_PLUS_6_YEARS")
  retentionTriggerDate            DateTime?
  retainUntil                     DateTime?
  lifecycleStatus                 RecordLifecycleStatus      @default(ACTIVE)
  legalHold                       Boolean                    @default(false)
  holdReason                      String?
  holdPlacedById                  Int?
  holdPlacedAt                    DateTime?
  holdReleasedById                Int?
  holdReleasedAt                  DateTime?
  archiveReference                String?
  archivedById                    Int?
  archivedAt                      DateTime?
  dispositionApprovedById         Int?
  dispositionApprovedAt           DateTime?
  destructionCertificateReference String?
  disposedById                    Int?
  disposedAt                      DateTime?
  notes                           String?
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt

  @@index([lifecycleStatus, retainUntil])
  @@index([legalHold])
  @@map("promotion_record_controls")
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model StatusHistory {
  id                 Int              @id @default(autoincrement())
  promotionRequestId Int
  promotionRequest   PromotionRequest @relation(fields: [promotionRequestId], references: [id], onDelete: Cascade)
  changedById        Int
  changedBy          User             @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  oldStatus          RequestStatus?
  newStatus          RequestStatus
  comment            String?
  createdAt          DateTime         @default(now())

  @@index([promotionRequestId])
  @@index([changedById])
  @@map("status_history")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model StaffMember {
  id                  Int                     @id @default(autoincrement())
  userId              Int?                    @unique
  user                User?                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  staffNumber         String                  @unique
  officialEmail       String                  @unique
  category            StaffCategory
  employmentStatus    EmploymentStatus        @default(ACTIVE)
  employmentStartedAt DateTime?
  retirementDate      DateTime?
  authoritativeSource String                  @default("HRODD")
  sourceRecordId      String?
  verificationState   RecordVerificationState @default(PENDING)
  recordVerifiedAt    DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  rankHistory             StaffRankHistory[]
  organizationAssignments StaffOrganizationAssignment[]
  officeAppointments      OfficeAppointment[]
  accessAssignments       StaffAccessAssignment[]

  @@index([category, employmentStatus])
  @@index([retirementDate])
  @@map("staff_members")
}

model StaffAccessAssignment {
  id                  Int                     @id @default(autoincrement())
  staffMemberId       Int
  staffMember         StaffMember             @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  role                StaffAccessRole
  organizationUnitId  Int?
  organizationUnit    OrganizationUnit?       @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  startedAt           DateTime
  endedAt             DateTime?
  appointingAuthority String?
  sourceReference     String?
  verificationState   RecordVerificationState @default(PENDING)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([staffMemberId, role, organizationUnitId, startedAt], map: "staff_access_assignments_staffMemberId_role_organizationUnitId_")
  @@index([staffMemberId, endedAt])
  @@index([role, organizationUnitId, endedAt])
  @@map("staff_access_assignments")
}

model RankDefinition {
  id         Int           @id @default(autoincrement())
  code       String        @unique
  name       String
  category   StaffCategory
  family     String?
  level      Int
  isTerminal Boolean       @default(false)
  isActive   Boolean       @default(true)
  validFrom  DateTime?
  validTo    DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  rankHistory   StaffRankHistory[]
  currentRoutes PromotionRoute[]   @relation("CurrentPromotionRank")
  targetRoutes  PromotionRoute[]   @relation("TargetPromotionRank")

  @@unique([category, name])
  @@index([category, level])
