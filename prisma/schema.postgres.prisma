  updatedAt   DateTime        @updatedAt

  versions PolicyVersion[]

  @@index([authority])
  @@map("policy_sources")
}

model PolicyVersion {
  id             Int                 @id @default(autoincrement())
  policySourceId Int
  policySource   PolicySource        @relation(fields: [policySourceId], references: [id], onDelete: Restrict)
  versionLabel   String
  status         PolicyVersionStatus @default(DRAFT)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
