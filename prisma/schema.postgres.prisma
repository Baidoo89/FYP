  dueAt              DateTime?
  decidedAt          DateTime?
  decision           String?
  decisionById       Int?
  decisionBy         User?            @relation("PromotionAppealDeciders", fields: [decisionById], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
