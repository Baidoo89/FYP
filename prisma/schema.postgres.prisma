  authority          DecisionAuthority
  meetingDate        DateTime
  quorumRequired     Int?
  quorumPresent      Int?
  quorumMet          Boolean?
  agendaReference    String?
  minutesDocumentId  Int?
  minutesDocument    Document?                     @relation("CommitteeMinutes", fields: [minutesDocumentId], references: [id], onDelete: SetNull)
  resolution         String?
