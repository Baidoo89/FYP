  updatedAt        DateTime       @updatedAt

  routeRequirements PromotionRouteAreaRequirement[]

  @@unique([promotionTrackId, code])
  @@index([promotionTrackId, sortOrder])
  @@map("assessment_area_definitions")
}

model PromotionRouteAreaRequirement {
  id               Int                      @id @default(autoincrement())
