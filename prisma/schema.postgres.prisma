model AcademicDossier {
  id                   Int              @id @default(autoincrement())
  promotionRequestId   Int              @unique
  promotionRequest     PromotionRequest @relation(fields: [promotionRequestId], references: [id], onDelete: Cascade)
  status               DossierStatus    @default(DRAFT)
  version              Int              @default(1)
  orcid                String?
  googleScholarUrl     String?
  teachingStatement    String?
  researchStatement    String?
  serviceStatement     String?
  applicantDeclaration Boolean          @default(false)
  declaredAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  scholarlyOutputs  ScholarlyOutput[]
  assessmentPackets AcademicAssessmentPacket[]

  @@index([status])
  @@map("academic_dossiers")
}

model ScholarlyOutput {
  id                           Int                 @id @default(autoincrement())
  academicDossierId            Int
  academicDossier              AcademicDossier     @relation(fields: [academicDossierId], references: [id], onDelete: Cascade)
  type                         ScholarlyOutputType
  title                        String
  citation                     String
  abstract                     String?
  publicationDate              DateTime?
  doi                          String?
  url                          String?
  issn                         String?
  isbn                         String?
  journalOrPublisher           String?
  volumeIssuePages             String?
  indexingSource               String?
  indexingVerifiedOn           DateTime?
  authors                      Json
  applicantAuthorPosition      Int?
  contributionStatement        String
  isRefereed                   Boolean             @default(false)
  isIndexed                    Boolean             @default(false)
  claimedForCurrentRoute       Boolean             @default(true)
  equivalenceUnits             Float
  departmentVerificationStatus VerificationStatus  @default(PENDING)
  departmentVerifiedById       Int?
  departmentVerifiedBy         User?               @relation("DepartmentOutputVerifier", fields: [departmentVerifiedById], references: [id], onDelete: SetNull)
  departmentVerificationNote   String?
  departmentVerifiedAt         DateTime?
  libraryVerificationStatus    VerificationStatus  @default(PENDING)
  libraryVerifiedById          Int?
  libraryVerifiedBy            User?               @relation("LibraryOutputVerifier", fields: [libraryVerifiedById], references: [id], onDelete: SetNull)
  libraryVerificationNote      String?
  libraryVerifiedAt            DateTime?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  packetItems AcademicAssessmentPacketItem[]

  @@unique([academicDossierId, doi])
  @@index([academicDossierId, claimedForCurrentRoute])
  @@index([departmentVerificationStatus, libraryVerificationStatus])
  @@map("scholarly_outputs")
}

model AcademicAssessmentPacket {
  id                      Int                  @id @default(autoincrement())
  academicDossierId       Int
  academicDossier         AcademicDossier      @relation(fields: [academicDossierId], references: [id], onDelete: Cascade)
  promotionRouteId        Int
  promotionRoute          PromotionRoute       @relation(fields: [promotionRouteId], references: [id], onDelete: Restrict)
  version                 Int                  @default(1)
  status                  AcademicPacketStatus @default(DRAFT)
  submittedOutputMinimum  Int?
  submittedOutputMaximum  Int?
  minimumRefereedOutputs  Int?
  bestOutputsRequired     Int?
  selectedOutputCount     Int                  @default(0)
  selectedEquivalentUnits Float                @default(0)
  ruleSnapshot            Json
  frozenById              Int?
  frozenBy                User?                @relation("AcademicPacketFreezer", fields: [frozenById], references: [id], onDelete: SetNull)
  frozenAt                DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  items AcademicAssessmentPacketItem[]

  @@unique([academicDossierId, version])
  @@index([promotionRouteId, status])
  @@index([frozenById])
  @@map("academic_assessment_packets")
}

model AcademicAssessmentPacketItem {
  id                         Int                      @id @default(autoincrement())
  academicAssessmentPacketId Int
  academicAssessmentPacket   AcademicAssessmentPacket @relation(fields: [academicAssessmentPacketId], references: [id], onDelete: Cascade)
  scholarlyOutputId          Int
  scholarlyOutput            ScholarlyOutput          @relation(fields: [scholarlyOutputId], references: [id], onDelete: Restrict)
  selectionOrder             Int
  equivalenceUnitsSnapshot   Float
  outputSnapshot             Json?
  createdAt                  DateTime                 @default(now())

  @@unique([academicAssessmentPacketId, scholarlyOutputId], map: "academic_packet_items_packet_output_key")
  @@unique([academicAssessmentPacketId, selectionOrder], map: "academic_packet_items_packet_order_key")
  @@index([scholarlyOutputId])
  @@map("academic_assessment_packet_items")
}

model OfficialFormTemplate {
